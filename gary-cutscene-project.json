      "lines": [
        {
          "id": "beat-1",
          "actor": "gary",
          "text": "Evening. Don’t suppose there’s anywhere still serving?",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 0
          }
        },
        {
          "id": "beat-2",
          "actor": "stranger",
          "text": "Nothing along here now.",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 0
          }
        },
        {
          "id": "beat-3",
          "actor": "gary",
          "text": "You’re telling me. I’ve reviewed three shutters and a bus stop.",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 0
          }
        },
        {
          "id": "beat-4",
          "actor": "stranger",
          "text": "You shouldn’t be on this road after closing.",
          "pause": 0.32,
          "animate": true,
          "poses": {
            "stranger": 1
          }
        },
        {
          "id": "beat-5",
          "actor": "gary",
          "text": "Closing? It’s a road.",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 1
          }
        },
        {
          "id": "beat-6",
          "actor": "stranger",
          "text": "Used to be.",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 1
          }
        },
        {
          "id": "beat-7",
          "actor": "gary",
          "text": "Right… Well, I was only looking for somewhere to eat.",
          "pause": 0.7,
          "animate": true,
          "poses": {
            "stranger": 1
          }
        },
        {
          "id": "beat-8",
          "actor": "stranger",
          "text": "Through the bridge. Follow the road past the trees.",
          "pause": 0.42,
          "animate": true,
          "poses": {
            "stranger": 3
          },
          "transitions": {
            "stranger": [
              2,
              3
            ]
          }
        },
        {
          "id": "beat-9",
          "actor": "gary",
          "text": "There’s somewhere out there?",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 3
          }
        },
        {
          "id": "beat-10",
          "actor": "stranger",
          "text": "You’ll see the lights.",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 3
          }
        },
        {
          "id": "beat-11",
          "actor": "gary",
          "text": "And they’ll still be serving?",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 3
          }
        },
        {
          "id": "beat-12",
          "actor": "stranger",
          "text": "They will tonight.",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 3
          }
        },
        {
          "id": "beat-13",
          "actor": "gary",
          "text": "Well, I’m not getting much round here.",
          "pause": 0.55,
          "animate": true,
          "poses": {
            "stranger": 3
          }
        },
        {
          "id": "beat-14",
          "actor": "stranger",
          "text": "Best keep moving.",
          "pause": 0,
          "animate": true,
          "poses": {
            "stranger": 3
          }
        },
        {
          "id": "beat-15",
          "actor": "gary",
          "text": "Cheers. Didn’t catch your name.",
          "pause": 0.45,
          "animate": true,
          "poses": {
            "stranger": 3
          }
        },
        {
          "id": "beat-16",
          "actor": "gary",
          "text": "Lovely. Very helpful. Mostly.",
          "pause": 0.8,
          "animate": true,
          "poses": {
            "stranger": 0
          },
          "transitions": {
